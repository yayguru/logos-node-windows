+/// Slots a published claim may stay unsettled before its ticket is claimed
+/// again, while its reward window is still open.
+///
+/// A claim normally settles within a few slots to ~40 slots. One that has not
+/// after this many was most likely lost on the way (Blend queue jam, dropped
+/// payload, a block that did not make it); left alone its reward expires with
+/// the window (`slot_window`, 100 slots). Re-claiming is safe: the ledger
+/// records the puzzle ticket as a nullifier, so at most one claim per ticket is
+/// ever paid, and tickets already settled are filtered out before a new claim
+/// tx is built (see `claim_ready_rewards`).
+const RECLAIM_AFTER_SLOTS: u64 = 45;
+
+/// Moves pending tickets back to the ready set once their claim has stayed
+/// unsettled for `reclaim_after` slots, if their reward window is still open.
+///
+/// Returns how many tickets were moved.
+fn requeue_unsettled_claims(
+    state: &mut PoWServiceState,
+    pending_first_seen: &mut HashMap<PowNullifier, Slot>,
+    tip_slot: Slot,
+    slot_window: NonZeroU64,
+    reclaim_after: u64,
+) -> usize {
+    let pending: HashSet<PowNullifier> = state
+        .pending_to_claim
+        .iter()
+        .map(|ticket| ticket.claim.get_puzzle_ticket())
+        .collect();
+    pending_first_seen.retain(|nullifier, _| pending.contains(nullifier));
+
+    let mut kept = Vec::with_capacity(state.pending_to_claim.len());
+    let mut requeued = 0;
+    for ticket in state.pending_to_claim.drain(..) {
+        let nullifier = ticket.claim.get_puzzle_ticket();
+        let first_seen = *pending_first_seen.entry(nullifier).or_insert(tip_slot);
+        let waited = u64::from(tip_slot).saturating_sub(u64::from(first_seen));
+        if waited >= reclaim_after && is_within_reward_window(ticket.block_slot, tip_slot, slot_window) {
+            pending_first_seen.remove(&nullifier);
+            state.ready_to_claim.push(ticket);
+            requeued += 1;
+        } else {
+            kept.push(ticket);
+        }
+    }
+    state.pending_to_claim = kept;
+    requeued
