+    /// Test that [`Leader::build_proof_for`] generates `PoL` which can be
+    /// verified successfully.
+    #[tokio::test]
+    async fn test_build_proof_for() {
+        let config = test_config();
+
+        // Create secret key and leader
+        let kms = DummyKms;
