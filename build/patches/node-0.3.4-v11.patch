+/// Number of PoW claims queued behind the stuck proposal in the jam tests.
+const JAM_CLAIMS: usize = 5;
+
+/// Sends one block proposal, then [`JAM_CLAIMS`] transactions, and expects
+/// every transaction to be blended within a few rounds.
+///
+/// With `chatter`, a status request also reaches the service every 500 ms, as
+/// the Windows panel's polling does. Every message that wins the service's
+/// `select!` rebuilds the encapsulation future, so a proposal wait that
+/// restarted on each attempt would never run out and the claims would still
+/// never leave.
+async fn assert_claims_drain_behind_a_stuck_proposal(
+    service: RunningEdgeService,
+    core_node: NodeId,
+    chatter: bool,
+) {
+    let RunningEdgeService {
+        handle: _join_handle,
+        epochs: _epoch_sender,
+        messages: msg_sender,
+        blended_to: mut node_id_receiver,
+        ..
+    } = service;
+
+    if chatter {
+        let chatter_sender = msg_sender.clone();
+        drop(tokio::spawn(async move {
+            for _ in 0..1_000 {
+                let (reply, _answer) = oneshot::channel();
+                if chatter_sender
+                    .send(ServiceMessage::GetPendingTransactions { reply })
+                    .await
+                    .is_err()
+                {
+                    return;
+                }
+                sleep(Duration::from_millis(500)).await;
+            }
+        }));
+    }
+
+    // Queued from a task of its own: the harness channels hold one message
+    // each, so the service can only take the next claim once the test has
+    // read the one blended before it.
+    let producer = msg_sender.clone();
+    drop(tokio::spawn(async move {
+        producer
+            .send(ServiceMessage::Blend(DataPayload::BlockProposal(b"own proposal".to_vec())))
+            .await
+            .unwrap();
+        for i in 0..JAM_CLAIMS {
+            producer
+                .send(ServiceMessage::Blend(DataPayload::Transaction(
+                    format!("pow claim {i}").into_bytes(),
