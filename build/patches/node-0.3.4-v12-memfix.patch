+    /// Measures the per-block voucher-path clone leak.
+    ///
+    /// A wallet keeps one `WalletState` per applied block until LIB prune.
+    /// The pre-fix `apply_voucher` rebuilt a unique `VoucherPaths` map (cloning
+    /// every MerklePath) on every block. This test keeps all states and applies
+    /// many blocks after a fixed set of vouchers is tracked, which is the same
+    /// growth the long-running node shows between LIB advances / during IBD.
+    #[test]
+    fn voucher_path_memory_stays_flat_after_tracked_set_is_stable() {
+        const TRACKED: u32 = 32;
+        const EXTRA: u32 = 3000;
+
+        let genesis = hid(0);
+        let ledger = LedgerState::from_utxos([], &ledger_config());
+        let known: Vec<_> = (0..TRACKED)
+            .map(|i| {
+                let (cm, nf) = voucher(1, u64::from(i));
+                (cm, nf, (1u64, u64::from(i)))
+            })
+            .collect();
+
+        let mut wallet = Wallet::<_, TestVoucherId>::from_lib_ledger_state(
+            empty::<(ZkPublicKey, u64)>(),
+            Vouchers::new(known.iter().copied()),
+            genesis,
+            &ledger,
+        );
+
+        let mut parent = genesis;
+        for i in 1..=TRACKED {
+            let id = hid(i);
+            wallet
+                .apply_block(&WalletBlock {
+                    id,
+                    parent,
+                    epoch: 1.into(),
+                    voucher_cm: known[(i as usize) - 1].0,
+                    header_ops: vec![],
+                    txs: BlockTransactions::empty(),
+                })
+                .unwrap();
+            parent = id;
+        }
+
+        // Touch the heap so the baseline includes the tracked set and setup.
+        let baseline_rss = rss_kb();
+        let baseline_anon = rss_anon_kb();
+
+        for i in 1..=EXTRA {
+            let id = hid(TRACKED + i);
+            let (foreign_cm, _) = voucher(2, u64::from(i));
+            wallet
+                .apply_block(&WalletBlock {
+                    id,
+                    parent,
+                    epoch: 1.into(),
+                    voucher_cm: foreign_cm,
+                    header_ops: vec![],
+                    txs: BlockTransactions::empty(),
+                })
+                .unwrap();
+            parent = id;
+        }
+
+        let after_rss = rss_kb();
+        let after_anon = rss_anon_kb();
+        let delta_rss = after_rss.saturating_sub(baseline_rss);
+        let delta_anon = after_anon.saturating_sub(baseline_anon);
+        println!(
+            "MEMTEST tracked={TRACKED} extra={EXTRA} states={} baseline_rss_kb={baseline_rss} after_rss_kb={after_rss} delta_rss_kb={delta_rss} baseline_anon_kb={baseline_anon} after_anon_kb={after_anon} delta_anon_kb={delta_anon}",
+            usize::try_from(TRACKED + EXTRA).unwrap() + 1,
+        );
+
+        // With path sharing, 3000 extra states should reuse the tracked paths.
+        // Allow a modest allocator/slack budget (maps, MMR peaks). The unfixed
+        // code clones 32 paths * 32 siblings on every block and grows many
+        // times this.
+        assert!(
+            delta_anon < 80_000,
+            "anonymous RSS grew by {delta_anon} kB over {EXTRA} blocks; voucher paths are probably being cloned per block"
+        );
+        let _ = parent;
+    }
